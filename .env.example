# ============================================================
# 模型服务配置模板
#
# 用法：复制本文件为 .env，填入自己的值。
#      .env 已被 .gitignore 排除，不会进仓库。
#      也可以不设文件、直接导出系统环境变量（见 README「步骤 2」）。
#
# 🔴 切勿把真实密钥提交到仓库。提交前执行：
#      git log -p | Select-String -Pattern "sk-[A-Za-z0-9]{20,}"
# ============================================================

# ---- 必填三项（留空时应用会拒绝发起请求并提示缺哪几项）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 可选，不填则用代码里的默认值 ----
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.0

# ============================================================
# 各项含义
# ------------------------------------------------------------
# LLM_BASE_URL   OpenAI 兼容接口的地址，以 /v1 结尾
#                例：https://api.deepseek.com/v1
#                    https://dashscope.aliyuncs.com/compatible-mode/v1
#                    https://api.openai.com/v1
# LLM_API_KEY    供应商控制台生成的密钥，形如 sk-xxxx
# LLM_MODEL      模型标识符，必须与供应商文档中的写法完全一致
#                例：deepseek-chat / qwen-plus / gpt-4o-mini
# LLM_MAX_TOKENS 单次回复的长度上限。带思维链的模型需要较大值，
#                否则 token 全花在内部推理上、可见输出为空（本项目默认 4000）
# ============================================================

# ============================================================
# ⚠️ 三条实测踩坑（排障时先看这里）
# ------------------------------------------------------------
# 1. 返回内容为空、无异常抛出
#    → 思考型模型的 token 预算不足。调大 LLM_MAX_TOKENS 或换非思考模型。
#      自检方法：看界面侧边栏的 token 统计，若 reasoning_tokens ≈ completion_tokens 即此问题
#
# 2. Error rendering prompt with jinja template: "No user query found in messages"
#    → 消息序列缺少 user 轮次。本项目已保证对话以 user 开头、以 user 结尾；
#      若仍出现，说明所选模型的 chat template 有缺陷，换一个模型即可
#
# 3. 上传图片后报 content / image 格式错误
#    → 该模型不支持多模态输入。代码会自动降级为纯文本路径并在结果中标注，
#      也可改用支持视觉的模型以获得完整功能
# ============================================================
